# Copy to .env (git-ignored) and fill in from Supabase: Project Settings > API Keys.
# `dart run bin/server.dart` reads this file automatically.
# The service role key bypasses RLS: keep it on the server only, never in the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PORT=8080
TURN_TIMEOUT_SECONDS=30
